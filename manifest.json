{
  "manifest_version": 3,
  "name": "Smartbox CRM Sidekick",
  "version": "1.1.6",
  "description": "Sidekick runs as the existing interface in an in-page launcher instead of the browser side panel.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "hid"
  ],
  "host_permissions": [
    "https://portal.talktometechnologies.com/*",
    "https://talktometechnologies2com.sharepoint.com/*",
    "https://smartboxassistivetnam.sharepoint.com/*",
    "https://forms.office.com/*",
    "https://crm.talktometechnologies.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "assets/SB logo.png",
    "32": "assets/SB logo.png",
    "48": "assets/SB logo.png",
    "128": "assets/SB logo.png"
  },
  "action": {
    "default_title": "Open Sidekick Overlay",
    "default_icon": {
      "16": "assets/SB logo.png",
      "32": "assets/SB logo.png",
      "48": "assets/SB logo.png",
      "128": "assets/SB logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "overlay.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.css",
        "themes.css",
        "panel.js",
        "libs/jszip.min.js",
        "workers/checkin-workflow-worker.js",
        "workers/zip-worker.js",
        "assets/*",
        "assets/Symojis/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
