{
  "manifest_version": 3,
  "name": "Smartbox CRM Sidekick",
  "version": "1.1.6",
  "description": "Injected CRM Sidekick overlay for TTMT CRM pages with side panel fallback.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "downloads",
    "storage",
    "hid"
  ],
  "host_permissions": [
    "https://portal.talktometechnologies.com/*",
    "https://talktometechnologies2com.sharepoint.com/*",
    "https://smartboxassistivetnam.sharepoint.com/*",
    "https://forms.office.com/*",
    "https://crm.talktometechnologies.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "icons": {
    "16": "assets/SB logo.png",
    "32": "assets/SB logo.png",
    "48": "assets/SB logo.png",
    "128": "assets/SB logo.png"
  },
  "action": {
    "default_title": "Open Sidekick Overlay",
    "default_icon": {
      "16": "assets/SB logo.png",
      "32": "assets/SB logo.png",
      "48": "assets/SB logo.png",
      "128": "assets/SB logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://crm.talktometechnologies.com/*",
        "https://portal.talktometechnologies.com/*",
        "https://talktometechnologies2com.sharepoint.com/*",
        "https://smartboxassistivetnam.sharepoint.com/*",
        "https://forms.office.com/*"
      ],
      "js": [
        "libs/jszip.min.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "overlay.css"
      ]
    }
  ]
}
